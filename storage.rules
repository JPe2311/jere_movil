rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    function validWrite() {
      return isAdmin() && (request.resource == null || request.resource.size < 500 * 1024 * 1024);
    }

    match /puntos/{allPaths=**} {
      allow read: if true;
      allow write: if validWrite();
    }

    match /quien_soy/{allPaths=**} {
      allow read: if true;
      allow write: if validWrite();
    }

    // Miniaturas de recursos (vidriera pública)
    match /recursos_publicos/{allPaths=**} {
      allow read: if true;
      allow write: if validWrite();
    }

    // Archivos descargables: solo usuarios con sesión
    match /recursos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if validWrite();
    }
  }
}
