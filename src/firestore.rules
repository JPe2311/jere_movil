rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    match /usuarios/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.role == 'user';
      allow update: if isAdmin();
    }

    match /puntos_mapa/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quien_soy_bloques/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();

      match /comentarios/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 1000;
        allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    match /recursos/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /descargas/{downloadId} {
        allow read, write: if false;
      }
    }

    match /configuracion/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Objetivos en el mapa (banderas 🏁): lectura pública, escritura solo admin
    match /objetivos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Eventos en vivo (seguimiento GPS del admin): lectura pública, escritura solo admin
    match /eventos_en_vivo/{id} {
      allow read: if true;
      allow write: if isAdmin();

      // Puntos del recorrido (track) del evento en vivo
      match /track/{trackId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
  }
}